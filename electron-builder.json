      "to": "modelscope.tokens.local.json"
    },
    {
      "from": "resources/acp/registry.json",
      "to": "acp/registry.json"
    },
    {
      "from": "resources/magpie/upstream.json",
      "to": "magpie/upstream.json"
    }
  ],
  "protocols": [
    {
      "name": "知远",
      "schemes": ["zhiyuan"]
    }
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.rongxzyai.com/v2/electron/stable/darwin/arm64/default"
