{
  "appId": "com.zhiyuanagent.app",
  "productName": "知远智能体 (ZhiYuan Agent)",
  "executableName": "知远",
  "directories": {
    "output": "release"
  },
  "afterSign": "scripts/notarize.js",
  "beforePack": "./scripts/electron-builder-hooks.cjs",
  "afterPack": "./scripts/electron-builder-hooks.cjs",
  "files": [
    "package.json",
    "resources/SYSTEM_PROMPT.md",
    {
      "from": "dist",
      "to": "dist",
      "filter": ["**/*", "!**/*.map"]
    },
    {
      "from": "dist-electron",
      "to": "dist-electron",
      "filter": ["**/*", "!**/*.map"]
    },
    "!**/*.map",
    "!**/*.d.ts",
    "!**/*.d.cts",
    "!**/*.d.mts",
    "!**/README.md",
    "!**/README",
    "!**/readme.md",
    "!**/CHANGELOG.md",
    "!**/CHANGELOG",
    "!**/HISTORY.md",
    "!**/.eslintrc*",
    "!**/.prettierrc*",
    "!**/tsconfig.json",
    "!**/tsconfig.*.json",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/tests/**",
    "!**/test/**",
    "!**/__tests__/**",
    "!node_modules/npm/docs/**",
    "!node_modules/npm/man/**",
    "!node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**",
    "!node_modules/@anthropic-ai/claude-agent-sdk-linux-*/**",
    "!node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**",
    "!node_modules/@openai/codex-darwin-*/**",
    "!node_modules/@openai/codex-linux-*/**",
    "!node_modules/@openai/codex-win32-*/**",
    "!node_modules/zod/src/**",
    "!node_modules/better-sqlite3/src/**",
    "!node_modules/better-sqlite3/deps/**",
    "!node_modules/node-pty/src/**",
    "!node_modules/node-pty/deps/**"
  ],
  "extraResources": [
    {
      "from": "build/icons/win/icon.ico",
      "to": "app-icons/icon.ico"
    },
    {
      "from": "build/icons/png/256x256.png",
      "to": "app-icons/icon.png"
    },
    {
      "from": "resources/tray",
      "to": "tray",
      "filter": ["**/*"]
    },
    {
      "from": "resources/llamacpp-backends",
      "to": "llamacpp-backends",
      "filter": ["**/*"]
    },
    {
