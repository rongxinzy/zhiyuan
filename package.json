{
  "name": "zhiyuan-agent",
  "desktopName": "zhiyuan.desktop",
  "description": "知远 - AI-assisted coding and productivity tool",
  "private": true,
  "author": {
    "name": "ZhiYuanAgent",
    "email": "dev@zhiyuanagent.com"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.0",
  "version": "2026.7.16",
  "llamacpp": {
    "runtimeRepo": "https://github.com/ggml-org/llama.cpp.git",
    "runtimeReleaseTag": "b9244",
    "runtimeAssets": {
      "mac-arm64": "llama-{tag}-bin-macos-arm64.tar.gz",
      "mac-x64": "llama-{tag}-bin-macos-x64.tar.gz",
      "win-x64": "llama-{tag}-bin-win-cpu-x64.zip",
      "win-x64-cuda-12": "llama-{tag}-bin-win-cuda-12.4-x64.zip",
      "win-arm64": "llama-{tag}-bin-win-cpu-arm64.zip",
      "linux-x64": "llama-{tag}-bin-ubuntu-x64.tar.gz",
      "linux-arm64": "llama-{tag}-bin-ubuntu-arm64.tar.gz"
    },
    "runtimeCompanionAssets": {
      "win-x64-cuda-12": []
    }
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run clean:build && bun run build:tsc && bun run build:vite && bun run check:electron-runtime-dependencies",
    "build:tsc": "tsc",
    "build:vite": "cross-env NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "build:eval-policy": "node scripts/build-zhiyuan-evaluation-policy.mjs",
    "build:enterprise": "tsup --config enterprise/tsup.config.ts && vite build --config enterprise/vite.ui.config.ts",
    "lint": "oxlint src/ enterprise/ && bun run theme:check && bun run theme:audit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "test": "node scripts/test-with-native-restore.cjs",
    "test:memory-leak": "node scripts/ci/memory-leak-check.mjs",
    "test:bundle-budget": "node scripts/check-renderer-bundle-budget.cjs",
    "check:supply-chain-inputs": "node scripts/ci/check-supply-chain-inputs.mjs",
    "check:openclaw-decoupling": "node scripts/ci/check-openclaw-decoupling.mjs",
    "test:visual-blind-review": "node tests/visualBlindReview.test.mjs",
    "test:enterprise": "vitest run --config enterprise/vitest.config.ts",
    "typecheck:enterprise": "tsc --project enterprise/tsconfig.json --noEmit && tsc --project enterprise/tsconfig.ui.json --noEmit",
    "verify:enterprise:bundle": "node enterprise/scripts/verify-bundle.mjs",
    "verify:enterprise:electron-package": "node enterprise/scripts/verify-electron-package.mjs",
    "verify:enterprise:electron-rc": "node enterprise/scripts/verify-electron-rc.mjs",
    "verify:enterprise:release-artifacts": "node enterprise/scripts/verify-release-artifacts.mjs",
    "verify:enterprise:packaging-config": "node scripts/ci/enterprise-builder-config.test.mjs",
    "test:sqlite-backup:seed": "node tests/sqlite-backup/generate-large-db.cjs",
    "preview": "vite preview",
    "compile:electron": "tsc --project electron-tsconfig.json",
    "precompile:electron": "electron-rebuild --only better-sqlite3,node-pty --force --build-from-source",
    "rebuild:electron-native": "electron-rebuild --only better-sqlite3,node-pty --force --build-from-source",
    "prepare:modelscope-tokens": "node scripts/write-modelscope-token-resource.cjs",
    "prepare:update-release": "node scripts/prepare-update-release.cjs",
    "build:electron:dev": "node scripts/build-electron-development.mjs",
    "start:electron": "cross-env NODE_ENV=development ELECTRON_START_URL=http://localhost:5175 electron --remote-debugging-port=9222 .",
    "start:electron:inspect": "cross-env NODE_ENV=development ELECTRON_START_URL=http://localhost:5175 electron --inspect=9229 --remote-debugging-port=9222 .",
    "electron:dev": "rimraf dist-electron && bun run build:electron:dev && node scripts/electron-dev.mjs",
    "apply:patches": "patch-package --error-on-fail",
    "postinstall": "bun run apply:patches && electron-builder install-app-deps",
    "pack": "npm run build && npm run compile:electron && npm run prepare:modelscope-tokens && electron-builder --dir",
    "dist": "npm run build && npm run compile:electron && npm run prepare:modelscope-tokens && electron-builder",
    "dist:mac": "npm run prepare:modelscope-tokens && electron-builder --mac --config electron-builder.json --publish never",
    "predist:mac": "npm run prepare:update-release && npm run build && npm run compile:electron",
    "dist:mac:x64": "npm run prepare:update-release && npm run build && npm run compile:electron && npm run prepare:modelscope-tokens && electron-builder --mac --x64",
    "dist:mac:arm64": "npm run prepare:update-release && npm run build && npm run compile:electron && npm run prepare:modelscope-tokens && electron-builder --mac --arm64",
    "dist:mac:universal": "npm run prepare:update-release && npm run build && npm run compile:electron && npm run prepare:modelscope-tokens && electron-builder --mac --universal",
    "dist:win": "bun run dist:win:setup",
    "dist:win:setup": "bun run dist:win:nsis && bun run build:installer-shell && bun run pack:installer-shell",
    "dist:win:nsis": "npm run prepare:update-release && cross-env ZHIYUAN_UPDATE_VARIANT=lite node scripts/ensure-build-version.js && npm run build && npm run prepare:modelscope-tokens && electron-builder --win nsis --x64 --config electron-builder.json --publish never",
    "dist:win:offline": "bun run dist:win:setup",
    "dist:win:signed": "npm run prepare:update-release && cross-env ZHIYUAN_UPDATE_VARIANT=lite node scripts/ensure-build-version.js && npm run build && npm run prepare:modelscope-tokens && electron-builder --win nsis --x64 --config electron-builder.windows-signed.cjs --publish never",
    "dist:win:enterprise": "npm run prepare:update-release && cross-env ZHIYUAN_UPDATE_VARIANT=lite node scripts/ensure-build-version.js && npm run build && npm run build:enterprise && npm run prepare:modelscope-tokens && electron-builder --win nsis --x64 --config electron-builder.enterprise.cjs --publish never",
    "dist:win:lite": "bun run dist:win:setup",
    "predist:linux": "node scripts/ensure-build-version.js && npm run prepare:update-release",
    "dist:linux": "npm run build && npm run compile:electron && npm run prepare:modelscope-tokens && electron-builder --linux --publish never",
    "clean:release": "rimraf release",
    "generate:tray-icons": "node scripts/generate-tray-icons.js",
    "generate:app-icons": "python3 scripts/generate-app-icons.py",
    "build:installer-shell": "node scripts/installer-shell/build-shell.cjs",
    "pack:installer-shell": "node scripts/installer-shell/pack-setup.cjs --app-dir release/win-unpacked --components-dir build-tar/windows-components",
    "generate:nsis-assets": "node scripts/generate-nsis-brand-assets.cjs",
    "setup:mingit": "node scripts/setup-mingit.js",
    "llamacpp:runtime:host": "node scripts/llamacpp-runtime-host.cjs",
    "llamacpp:runtime:download": "node scripts/download-llamacpp-runtime.cjs",
    "llamacpp:runtime:download:mac-arm64": "node scripts/download-llamacpp-runtime.cjs mac-arm64",
    "llamacpp:runtime:download:mac-x64": "node scripts/download-llamacpp-runtime.cjs mac-x64",
    "llamacpp:runtime:download:win-x64": "node scripts/download-llamacpp-runtime.cjs win-x64",
    "llamacpp:runtime:download:win-x64-cuda-12": "node scripts/download-llamacpp-runtime.cjs win-x64-cuda-12",
    "llamacpp:runtime:download:linux-x64": "node scripts/download-llamacpp-runtime.cjs linux-x64",
    "llamacpp:runtime:download:linux-arm64": "node scripts/download-llamacpp-runtime.cjs linux-arm64",
    "llamacpp:runtime:mac-arm64": "node scripts/run-build-llamacpp-runtime.cjs mac-arm64 && node scripts/sync-llamacpp-runtime-current.cjs mac-arm64",
    "llamacpp:runtime:mac-x64": "node scripts/run-build-llamacpp-runtime.cjs mac-x64 && node scripts/sync-llamacpp-runtime-current.cjs mac-x64",
    "llamacpp:runtime:win-x64": "node scripts/run-build-llamacpp-runtime.cjs win-x64 && node scripts/sync-llamacpp-runtime-current.cjs win-x64",
    "llamacpp:runtime:linux-x64": "node scripts/run-build-llamacpp-runtime.cjs linux-x64 && node scripts/sync-llamacpp-runtime-current.cjs linux-x64",
    "llamacpp:runtime:linux-arm64": "node scripts/run-build-llamacpp-runtime.cjs linux-arm64 && node scripts/sync-llamacpp-runtime-current.cjs linux-arm64",
    "upload:artifact": "node scripts/upload-artifact.cjs",
    "regenerate:icon": "python3 scripts/generate-app-icons.py",
    "fix:mac-icon": "bash scripts/fix-mac-icon-display.sh",
    "check:electron-runtime-dependencies": "node scripts/ci/check-electron-runtime-dependencies.mjs --resolve",
    "theme:generate": "bun src/renderer/theme/scripts/generate-css.ts",
    "theme:check": "bun src/renderer/theme/scripts/generate-css.ts --check",
    "theme:audit": "bun src/renderer/theme/scripts/audit-styles.ts",
    "magpie:build": "node scripts/build-magpie-runtime.cjs",
    "magpie:verify": "node scripts/verify-magpie-runtime.cjs",
    "python:build:job-runner": "pwsh -NoProfile -File scripts/python-runtime/build-job-runner.ps1",
    "clean:build": "rimraf dist dist-electron"
  },
