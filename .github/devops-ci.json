{
  "workflows": [
    {
      "name": "Lightweight CI",
      "path": ".github/workflows/lightweight-ci.yml",
      "branches": [
        "main"
      ]
    },
    {
      "name": "Python runtime process containment",
      "path": ".github/workflows/python-runtime.yml",
      "paths": [
        "src/main/pythonRuntime/**",
        "src/main/libs/agentEngine/durable/pythonTools*",
        "scripts/python-runtime/**",
        ".github/workflows/python-runtime.yml"
      ]
    },
    {
      "name": "Installer visual review only",
      "path": ".github/workflows/installer-style-preview.yml",
      "paths": [
        "scripts/installer-shell/preview/**",
        "scripts/installer-shell/preview-ui.test.ts",
        "scripts/ci/installer-style-preview.py",
        ".github/workflows/installer-style-preview.yml"
      ]
    }
  ],
  "optionalWorkflows": [
    {
      "name": "Windows x64 unsigned acceptance",
      "path": ".github/workflows/windows-acceptance.yml",
      "reason": "Explicit unsigned Windows acceptance build; manual or acceptance-path push only, no PR requirement or public release."
    }
  ]
}
